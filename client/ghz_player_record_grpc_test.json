{
  "proto": "../src/main/proto/player.proto",
  "call": "Player/GetPlayerRecordById",
  "total": 500,
  "concurrency": 10,
  "load-schedule": "step",
  "load-start": 1,
  "load-end": 10,
  "load-step": 1,
  "load-step-duration": "1s",
  "max-duration": "30s",
  "data": {
    "id": "{{ randomInt 1 11075 }}"
  },
  "metadata": {
    "trace_id": "{{.RequestNumber}}",
    "timestamp": "{{.TimestampUnix}}"
  },
  "import-paths": [
    "../src/main/proto"
  ],
  "host": "localhost:8088",
  "skipTLS": true,
  "insecure": true
}
